        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض Underbrim الكاميرا في مرآة النوتش أثناء فتحها، ولا يُسجَّل شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underbrim zeigt das Bild deiner Kamera im Spiegel der Notch, solange du ihn geöffnet hast. Es wird nichts aufgezeichnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Underbrim shows your camera in the notch's mirror while you have it open. Nothing is recorded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underbrim muestra la imagen de tu cámara en el espejo del notch mientras lo tienes abierto. No se graba nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underbrim affiche l’image de votre caméra dans le Miroir de l’encoche tant que vous le gardez ouvert. Rien n’est enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underbrim mostra l’immagine della fotocamera nello specchio del notch mentre lo tieni aperto. Non viene registrato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underbrimは、ノッチのミラーを開いている間、そこにカメラの映像を表示します。映像が録画されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underbrim은 노치의 거울이 열려 있는 동안 거울에 카메라 화면을 표시합니다. 아무것도 녹화되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Underbrim mostra a imagem da sua câmera no espelho do notch enquanto ele está aberto. Nada é gravado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underbrim показывает изображение с камеры в зеркале выреза, пока оно открыто. Ничего не записывается."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underbrim, çentikteki aynayı açık tuttuğunuz sürece kameranızın görüntüsünü orada gösterir. Hiçbir şey kaydedilmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underbrim会在你打开刘海中的镜子时显示摄像头画面。不会录制任何内容。"
          }
        }
      }
    },
    "NSHumanReadableCopyright" : {
      "comment" : "Copyright (human-readable)",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
