    "NSLocationUsageDescription" : {
      "comment" : "Privacy - Location Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Underbrim موقعك لحساب مواقيت الصلاة، ويبقى موقعك على هذا الـ Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underbrim verwendet deinen Standort, um die Gebetszeiten zu berechnen. Er bleibt auf diesem Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Underbrim uses your location to work out prayer times. It stays on this Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underbrim usa tu ubicación para calcular los horarios de oración. Tu ubicación no sale de este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underbrim utilise votre position pour calculer les horaires de prière. Elle reste sur ce Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underbrim usa la tua posizione per calcolare gli orari di preghiera. La posizione resta su questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underbrimは、礼拝時間を計算するために位置情報を使用します。位置情報がこのMacの外に送られることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underbrim은 사용자의 위치를 사용하여 예배 시간을 계산합니다. 위치는 이 Mac 밖으로 전송되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Underbrim usa sua localização para calcular os horários de oração. Ela permanece neste Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underbrim использует Вашу геопозицию, чтобы рассчитать время намаза. Она остается на этом Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underbrim, namaz vakitlerini hesaplamak için konumunuzu kullanır. Konumunuz bu Mac’te kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underbrim使用你的位置来计算礼拜时间。你的位置只保留在这台Mac上。"
          }
        }
      }
    },
