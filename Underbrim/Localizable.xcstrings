    "Using %@ instead. Your Now Playing preference is preserved." : {
      "comment" : "Media settings footer for a non-recoverable Now Playing setup failure. The placeholder is the active fallback source.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجري استخدام %@ بدلًا من ذلك. ويبقى \"قيد التشغيل\" المصدر المفضل لديك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stattdessen wird %@ verwendet. Deine Einstellung „Jetzt läuft“ bleibt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using %@ instead. Your Now Playing preference is preserved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se está usando %@ en su lugar. Se conserva tu preferencia por Ahora suena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est utilisé à la place. Votre préférence pour « À l’écoute » est conservée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene usato %@ al suo posto. La tua preferenza per “In riproduzione” è conservata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代わりに%@を使用しています。“再生中”の設定はそのまま保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대신 %@을(를) 사용 중입니다. ‘지금 재생 중’ 설정은 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usando %@ em vez disso. Sua preferência pelo Reproduzindo foi mantida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вместо этого используется %@. Выбор источника «Исполняется» сохранен."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunun yerine %@ kullanılıyor. Şu An Çalınan tercihiniz korunuyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在改用%@。你选择的“播放中”仍会保留。"
          }
        }
      }
    },
