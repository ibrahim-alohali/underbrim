    "Calculated on your Mac with %@. Check once against your local mosque." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محسوبة على هذا الـ Mac بطريقة %@. قارنها مرة واحدة بمواقيت مسجد حيّك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zeiten werden auf deinem Mac mit der Methode „%@“ berechnet. Gleiche sie einmal mit deiner Moschee vor Ort ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los horarios se calculan en tu Mac con el método %@. Compáralos una vez con los de tu mezquita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Horaires calculés sur votre Mac (%@). Comparez-les une fois avec ceux de votre mosquée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calcolati sul Mac con il metodo %@. Confrontali una volta con gli orari della tua moschea."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の方式でこのMac上で計算されます。一度、地元のモスクの時刻と照らし合わせてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac에서 %@ 방식으로 계산합니다. 가까운 모스크의 시간과 한 번 비교해 보십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculado no seu Mac pelo método %@. Confira uma vez com a mesquita da sua região."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рассчитано на этом Mac по методу «%@». Один раз сверьте с расписанием ближайшей мечети."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac’inizde %@ yöntemiyle hesaplanır. Bir kez yakınınızdaki caminin vakitleriyle karşılaştırın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用“%@”方法在你的Mac上计算。请与当地清真寺的时间核对一次。"
          }
        }
      }
    },
