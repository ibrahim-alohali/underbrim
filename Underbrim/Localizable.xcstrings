          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio de sesión, el icono de la barra de menús, el idioma, cómo se abre el notch y sus atajos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouverture avec la session, icône de la barre des menus, langue, ouverture de l’encoche et ses raccourcis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apertura al login, icona nella barra dei menu, lingua, come si apre il notch e le sue scorciatoie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログイン、メニューバーのアイコン、言語、ノッチの開きかた、そのショートカット。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
