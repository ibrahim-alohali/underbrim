    "In Codex's main window, click Review hooks next to the message box." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم الموافقة من نافذة Codex الرئيسية بالنقر على \"مراجعة hooks\" بجوار مربع الرسالة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke im Hauptfenster von Codex neben dem Eingabefeld auf „Hooks prüfen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la ventana principal de Codex, haz clic en “Review hooks”, junto al cuadro de mensaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans la fenêtre principale de Codex, cliquez sur « Review hooks » à côté du champ de message."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella finestra principale di Codex, fai clic su “Rivedi gli hook” accanto al campo del messaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codexのメインウインドウで、メッセージ入力欄の横にある“フックを確認”をクリックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex 메인 윈도우에서 메시지 상자 옆의 ‘훅 검토’를 클릭하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na janela principal do Codex, clique em “Revisar hooks”, ao lado da caixa de mensagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В главном окне Codex нажмите «Проверить хуки» рядом с полем ввода."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
