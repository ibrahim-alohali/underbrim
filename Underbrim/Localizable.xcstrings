    "Made in the app, at the alert volume set in Sound settings, through the device chosen for alerts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُولَّد الأصوات داخل التطبيق، بمستوى صوت التنبيهات المحدد في إعدادات الصوت، وعبر الجهاز المختار للتنبيهات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der App erzeugt, mit der in den Toneinstellungen festgelegten Lautstärke für Hinweistöne, über das für Hinweistöne gewählte Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se generan en la app, con el volumen de alertas definido en los ajustes de Sonido y a través del dispositivo elegido para las alertas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créés dans l’app, au volume des alertes défini dans les réglages Son, sur l’appareil choisi pour les alertes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generati dall’app, con il volume degli avvisi impostato nelle impostazioni Suono e tramite il dispositivo scelto per gli avvisi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ内で生成され、“サウンド”設定で設定した警告音量で、警告用に選択したデバイスから再生されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 안에서 만들어지며, 사운드 설정에서 정한 알림 음량으로, 알림용으로 선택한 기기를 통해 재생됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerados no app, com o volume de alertas definido nos ajustes de Som, pelo dispositivo escolhido para os alertas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создаются в приложении, с громкостью оповещений из настроек «Звук», через устройство, выбранное для оповещений."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamada üretilir; Ses ayarlarında belirlenen uyarı ses yüksekliğiyle, uyarılar için seçilen aygıt üzerinden çalınır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在App内生成，使用“声音”设置中设定的提示音量，通过为提醒所选的设备播放。"
          }
        }
      }
    },
