          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si macOS pregunta por la clave del portapapeles de Underbrim, responde al aviso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si macOS pose une question sur la clé du presse-papiers d’Underbrim, répondez-y."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se macOS chiede l’accesso alla chiave degli appunti di Underbrim, rispondi alla richiesta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSからUnderbrimのクリップボードキーについて確認された場合は、そのダイアログに応答してください。"
          }
        },
        "ko" : {
