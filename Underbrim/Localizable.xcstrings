    "Timed events only — not all-day events, reminders or meetings you declined." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأحداث ذات الوقت المحدد فقط، دون أحداث طوال اليوم أو التذكيرات أو الاجتماعات التي رفضتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Ereignisse mit Uhrzeit – keine ganztägigen Ereignisse, Erinnerungen oder abgelehnten Meetings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo eventos con hora: no incluye eventos de todo el día, recordatorios ni reuniones que hayas rechazado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Évènements avec horaire uniquement — ni évènements sur toute la journée, ni rappels, ni réunions refusées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo eventi con orario — non quelli di tutto il giorno, i promemoria o le riunioni che hai rifiutato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時刻が設定された予定のみが対象です。終日の予定、リマインダー、辞退した会議は含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시간이 지정된 이벤트만 해당하며, 하루 종일 이벤트, 미리 알림 또는 거절한 회의는 제외됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas eventos com horário — sem eventos de dia inteiro, lembretes ou reuniões que você recusou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только события с указанным временем — без событий на весь день, напоминаний и отклоненных встреч."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca saati belirli etkinlikler — tam gün etkinlikler, anımsatıcılar veya reddettiğiniz toplantılar değil."
          }
        },
        "zh-Hans" : {
