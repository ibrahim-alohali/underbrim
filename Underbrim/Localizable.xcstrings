    "%@ also answer Claude's requests, so each one shows there too. The first answer counts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرد %@ أيضًا على طلبات Claude، لذا يظهر كل طلب هناك أيضًا. ويُعتمد أول رد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ beantworten ebenfalls Anfragen von Claude, daher erscheint jede auch dort. Die erste Antwort zählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ también responden a las solicitudes de Claude, así que cada una aparece también allí. Cuenta la primera respuesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ répondent aussi aux demandes de Claude : chacune s’y affiche donc également. La première réponse compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ rispondono anche alle richieste di Claude, quindi ognuna compare anche lì. Conta la prima risposta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@もClaudeのリクエストに回答するため、各リクエストはそこにも表示されます。先に行った回答が有効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@도 Claude의 요청에 답변하므로 각 요청이 그쪽에도 표시됩니다. 먼저 한 답변이 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ também respondem às solicitações do Claude, então cada uma aparece lá também. Vale a primeira resposta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ тоже отвечают на запросы Claude, поэтому каждый из них показывается и там. Учитывается первый ответ."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude’un isteklerini yanıtlayan başka uygulamalar da var: %@. Her istek bunlarda da görünür. İlk verilen yanıt geçerli olur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@也会回答Claude的请求，因此每个请求也会显示在那里。以先做出的回答为准。"
          }
        }
      }
    },
    "%@ also answer Codex's approvals, and Codex waits for every app that does. Keep only one of them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرد %@ أيضًا على طلبات الموافقة من Codex، وينتظر Codex كل تطبيق يفعل ذلك. يلزم الإبقاء على واحد منها فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ beantworten ebenfalls Genehmigungen von Codex, und Codex wartet auf jede App, die das tut. Behalte nur eine davon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ también responden a las aprobaciones de Codex, y Codex espera a todas las apps que lo hacen. Deja solo una de ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ répondent aussi aux demandes d’approbation de Codex, et Codex attend chaque app qui le fait. N’en gardez qu’une."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ rispondono anche alle approvazioni di Codex, e Codex attende ogni app che lo fa. Tienine solo una."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@もCodexの承認に回答しており、Codexは回答するすべてのアプリを待ちます。1つだけ残してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@도 Codex의 승인에 답변하며, Codex는 답변하는 모든 앱을 기다립니다. 하나만 남기십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ também respondem às aprovações do Codex, e o Codex aguarda todos os apps que fazem isso. Mantenha apenas um deles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ тоже отвечают на одобрения Codex, а Codex ждет каждое такое приложение. Оставьте только одно из них."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex’in onaylarını yanıtlayan başka uygulamalar da var: %@. Codex, bunu yapan her uygulamayı bekler. Yalnızca birini bırakın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@也会回答Codex的批准请求，而Codex会等待每一个这样的App。请只保留其中一个。"
          }
        }
      }
    },
