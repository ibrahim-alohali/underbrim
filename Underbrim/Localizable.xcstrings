    "%@'s settings can't be read safely (%@), so they won't be changed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتعذر قراءة إعدادات %@ بأمان (%@)، لذا لن تُغيَّر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einstellungen von %@ können nicht sicher gelesen werden (%@) und werden daher nicht geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes de %@ no se pueden leer con seguridad (%@), así que no se modificarán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages de %@ ne peuvent pas être lus en toute sécurité (%@) ; ils ne seront donc pas modifiés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni di %@ non possono essere lette in sicurezza (%@), quindi non verranno modificate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@の設定を安全に読み取れないため（%2$@）、変更しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@의 설정을 안전하게 읽을 수 없어(%2$@) 변경하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As configurações do %@ não podem ser lidas com segurança (%@), então não serão alteradas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки %@ нельзя безопасно прочитать (%@), поэтому они не будут изменены."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ayarları güvenle okunamıyor (%2$@), bu yüzden değiştirilmeyecek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法安全读取%1$@的设置（%2$@），因此不会对其进行更改。"
          }
        }
      }
    },
