    "Your accent color and how the open notch looks." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لون التمييز ومظهر النوتش المفتوح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Akzentfarbe und das Aussehen der geöffneten Notch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu color de contraste y el aspecto del notch abierto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre couleur d’accentuation et l’apparence de l’encoche ouverte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il colore dettagli e l’aspetto del notch aperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセントカラーと、開いたノッチの見た目。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강조 색상과 열린 노치의 모양."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua cor de realce e a aparência do notch aberto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цветовой акцент и вид открытого выреза."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vurgu renginiz ve açık çentiğin görünüşü."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强调色，以及刘海展开时的外观。"
          }
        }
      }
    },
    "Your Claude login is never read: Anthropic's terms don't allow other apps to use Claude.ai credentials." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُقرأ بيانات تسجيل دخولك إلى Claude أبدًا، إذ لا تسمح شروط Anthropic للتطبيقات الأخرى باستخدام بيانات اعتماد Claude.ai."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Claude-Anmeldung wird nie gelesen: Die Bedingungen von Anthropic erlauben anderen Apps nicht, Zugangsdaten von Claude.ai zu verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos de inicio de sesión de Claude nunca se leen: las condiciones de Anthropic no permiten que otras apps usen las credenciales de Claude.ai."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos identifiants Claude ne sont jamais lus : les conditions d’Anthropic n’autorisent pas d’autres apps à utiliser les identifiants Claude.ai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dati di accesso a Claude non vengono mai letti: i termini di Anthropic non consentono ad altre app di usare le credenziali di Claude.ai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claudeのログイン情報が読み取られることはありません。Anthropicの規約では、ほかのアプリがClaude.aiの認証情報を使用することは認められていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude 로그인 정보는 절대 읽지 않습니다. Anthropic의 약관은 다른 앱이 Claude.ai 자격 증명을 사용하는 것을 허용하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus dados de login do Claude nunca são lidos: os termos da Anthropic não permitem que outros apps usem as credenciais do Claude.ai."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные Вашего входа в Claude никогда не считываются: условия Anthropic запрещают другим приложениям использовать учетные данные Claude.ai."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude giriş bilgileriniz asla okunmaz: Anthropic’in koşulları, diğer uygulamaların Claude.ai kimlik bilgilerini kullanmasına izin vermez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绝不会读取你的Claude登录信息：Anthropic的条款不允许其他App使用Claude.ai凭证。"
          }
        }
      }
    },
    "Your headphones' battery levels." : {
      "localizations" : {
