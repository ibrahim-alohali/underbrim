        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Ya está activado para Underbrim? Quita Underbrim de la lista con − y vuelve a añadirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjà activée pour Underbrim ? Retirez Underbrim de la liste avec −, puis ajoutez-le à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Già attivo per Underbrim? Rimuovi Underbrim dall’elenco con − e aggiungilo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underbrimがすでにオンになっている場合は、“−”でリストから削除してから、もう一度追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목록에서 Underbrim이 이미 켜져 있습니까? −를 클릭하여 목록에서 제거한 다음 다시 추가하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já está ativado para o Underbrim? Remova o Underbrim da lista com − e adicione-o de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже включено для Underbrim? Удалите его из списка кнопкой «−» и добавьте снова."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underbrim için zaten açık mı? Listeden − düğmesiyle kaldırıp yeniden ekleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已为Underbrim打开？请用“−”将其从列表中移除，然后重新添加。"
          }
        }
      }
    },
    "Also used by %@. Only one app gets a shortcut, so pick another for one of them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدمه أيضًا %@. لا يحصل على الاختصار إلا تطبيق واحد، لذا يلزم اختيار اختصار آخر لأحدها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird auch von %@ verwendet. Nur eine App erhält einen Kurzbefehl, wähle also für eine davon einen anderen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También lo usa %@. Solo una app puede tener el atajo, así que elige otro para una de ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Également utilisé par %@. Une seule app peut avoir un raccourci : choisissez-en un autre pour l’une d’elles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È usata anche da %@. Una scorciatoia può appartenere a una sola app: scegline un’altra per una di esse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@でも使用されています。ショートカットを割り当てられるアプリは1つだけなので、どちらかに別のショートカットを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서도 사용 중입니다. 단축키는 앱 하나에만 지정할 수 있으므로 그중 하나에 다른 단축키를 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também usado por %@. Apenas um app recebe o atalho, então escolha outro para um deles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это сочетание также используется для: %@. Сочетание можно назначить только одному приложению, поэтому выберите другое для одного из них."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tarafından da kullanılıyor. Bir kestirmeyi yalnızca bir uygulama alabilir, bu yüzden bunlardan biri için başka bir kestirme seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@也在使用。一个快捷键只能用于一个App，因此请为其中之一另选一个快捷键。"
          }
        }
      }
    },
