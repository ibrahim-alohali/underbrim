    "Replaces macOS's own, plus Caps Lock. Asks for %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدلًا من مؤشر macOS، مع مفتاح Caps Lock. يطلب إذن %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statt der macOS-Anzeige, dazu die Feststelltaste. Benötigt „%@“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En vez del de macOS, con Bloqueo Mayúsculas. Pide permiso de %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À la place de macOS, avec Verr. maj. Nécessite « %@ »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al posto di quelli di macOS, con Blocco maiuscole. Richiede “%@”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSの表示の代わりに表示。Caps Lockも。%@の許可を求めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 대신 표시하며 Caps Lock도 표시합니다. %@ 권한을 요청합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em vez do macOS, além do Caps Lock. Pede permissão de %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вместо индикатора macOS, плюс Caps Lock. Запросит «%@»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS’inki yerine; Büyük Harf Kilidi de. %@ izni ister."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取代macOS的指示器，并显示大写锁定。需要“%@”权限。"
          }
        }
      }
    },
    "Replaces macOS's own, plus Focus and Caps Lock. Asks for %@." : {
      "localizations" : {
