        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Unirse” solo abre enlaces de vídeo de servicios de reuniones conocidos (Zoom, Google Meet, Teams, Webex, Whereby, Jitsi)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Rejoindre » n’ouvre que les liens vidéo des services de réunion connus (Zoom, Google Meet, Teams, Webex, Whereby, Jitsi)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Partecipa” apre solo i link video di servizi di riunione conosciuti (Zoom, Google Meet, Teams, Webex, Whereby, Jitsi)."
