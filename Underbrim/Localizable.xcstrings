          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일은 다운로드 폴더에 그대로 있으며, 선반은 해당 파일을 가리키기만 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo permanece na sua pasta Downloads; a Prateleira apenas aponta para ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл остается в папке «Загрузки», а Полка лишь ссылается на него."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosya İndirilenler klasörünüzde kalır; Raf yalnızca dosyaya bir bağlantı tutar."
