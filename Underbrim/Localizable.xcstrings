    "Login, the menu bar icon, language, how the notch opens, and its shortcuts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الفتح عند الدخول، وأيقونة شريط القوائم، واللغة، وطريقة فتح النوتش، واختصاراته."
          }
        },
        "de" : {
          "stringUnit" : {
