    "Moves with what's playing. Asks to capture audio." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحرك مع ما يُشغَّل. يطلب إذن التقاط الصوت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegt sich mit der Wiedergabe. Benötigt Audioaufnahme."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se mueve con lo que suena. Pide permiso para capturar audio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suit le son en cours de lecture. Demande à capturer l’audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segue ciò che è in riproduzione. Chiede di registrare l’audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生中の音に合わせて動きます。システムオーディオ録音の許可を求めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생 중인 소리에 맞춰 움직입니다. 오디오 녹음 권한을 요청합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanha o que está tocando. Pede para capturar o áudio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Движется в такт звуку. Запросит разрешение на запись звука."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalan sesle birlikte hareket eder. Sistem sesi kaydı izni ister."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随播放内容律动。会请求系统录音权限。"
          }
        }
      }
    },
