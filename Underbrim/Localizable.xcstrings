          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underbrim не удалось настроить вспомогательную программу, которую запускают агенты и Chrome (%@)."
          }
        },
        "tr" : {
          "stringUnit" : {
