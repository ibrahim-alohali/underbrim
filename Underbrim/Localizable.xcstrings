    "Sneak Peek shows the media title and artist under the notch for a few seconds." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعرض اللمحة السريعة عنوان الوسائط واسم الفنان أسفل النوتش لبضع ثوانٍ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kurzeinblendung zeigt Titel und Interpret einige Sekunden lang unter der Notch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sneak Peek shows the media title and artist under the notch for a few seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El vistazo muestra el título y el artista bajo el notch durante unos segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’aperçu furtif affiche le titre et l’artiste sous l’encoche pendant quelques secondes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’anteprima rapida mostra per qualche secondo titolo e artista sotto il notch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スニークピークでは、メディアのタイトルとアーティスト名がノッチの下に数秒間表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "살짝 보기는 노치 아래에 미디어 제목과 아티스트를 몇 초 동안 표시합니다."
          }
        },
        "pt-BR" : {
