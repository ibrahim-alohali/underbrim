    "Lets Underbrim change an app's sound. Nothing is recorded or saved." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح لـ Underbrim تغيير صوت أي تطبيق. لا يُسجَّل أي شيء ولا يُحفظ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermöglicht Underbrim, den Ton einer App zu ändern. Nichts wird aufgenommen oder gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que Underbrim cambie el sonido de una app. No se graba ni se guarda nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à Underbrim de modifier le son d’une app. Rien n’est enregistré ni conservé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consente a Underbrim di modificare l’audio di un’app. Non viene registrato né salvato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underbrimがアプリのサウンドを変更できるようにします。録音や保存は行われません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underbrim이 앱의 소리를 변경할 수 있게 합니다. 아무것도 녹음하거나 저장하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que o Underbrim altere o som de um app. Nada é gravado nem salvo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволяет Underbrim менять звук приложения. Ничего не записывается и не сохраняется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underbrim’in bir uygulamanın sesini değiştirmesine izin verir. Hiçbir şey kaydedilmez veya saklanmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许Underbrim更改App的声音。不会录制或存储任何内容。"
          }
        }
      }
    },
    "Lets Underbrim press Claude's button for you: allow it in Accessibility" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح لـ Underbrim ضغط زر Claude نيابةً عنك: اسمح به في تسهيلات الاستخدام"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit Underbrim die Taste in Claude für dich drückt: in den Bedienungshilfen erlauben"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que Underbrim pulse el botón de Claude por ti: permítelo en Accesibilidad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à Underbrim d’appuyer sur le bouton de Claude pour vous : autorisez-le dans Accessibilité"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permette a Underbrim di premere il pulsante di Claude per te: consentilo in Accessibilità"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UnderbrimがClaudeのボタンを代わりに押せるようにします：アクセシビリティで許可してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underbrim이 Claude의 버튼을 대신 누르도록 합니다: 손쉬운 사용에서 허용하세요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que o Underbrim aperte o botão do Claude por você: permita em Acessibilidade"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволяет Underbrim нажимать кнопку Claude за вас: разрешите это в Универсальном доступе"
