    "Drop files on the island to keep them for later, or to AirDrop and share them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أفلِت الملفات على الجزيرة للاحتفاظ بها لوقت لاحق، أو لإرسالها بالإرسال السريع ومشاركتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege Dateien auf der Insel ab, um sie für später aufzubewahren oder per AirDrop zu senden und zu teilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suelta archivos en la isla para tenerlos a mano, enviarlos por AirDrop o compartirlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déposez des fichiers sur l’île pour les mettre de côté, les envoyer par AirDrop ou les partager."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina i file sull’isola per conservarli per dopo, o per inviarli con AirDrop e condividerli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルをアイランドにドロップして一時的に置いておいたり、AirDropや共有で送ったりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일을 아일랜드로 드래그해 두면 나중에 사용하거나 AirDrop으로 보내고 공유할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solte arquivos na ilha para guardar para depois, enviar por AirDrop ou compartilhar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетяните файлы на остров, чтобы отложить их на потом, отправить через AirDrop или поделиться ими."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosyaları sonraya saklamak ya da AirDrop ile gönderip paylaşmak için adaya bırakın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将文件拖放到悬浮岛上以便稍后使用，或用隔空投送发送和共享。"
          }
        }
      }
    },
    "Drop files on the notch to keep them close, then drag or share them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى الملفات التي تُفلت على النوتش في المتناول، لسحبها أو مشاركتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege Dateien auf der Notch ab, um sie griffbereit zu haben, und ziehe oder teile sie dann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suelta archivos en el notch para tenerlos a mano y luego arrastrarlos o compartirlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déposez des fichiers sur l’encoche pour les garder à portée de main, puis faites-les glisser ou partagez-les."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina i file sul notch per averli a portata di mano, poi trascinali altrove o condividili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルをノッチにドロップして手元に置き、あとでドラッグしたり共有したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노치에 놓은 파일을 가까이 두고 필요할 때 드래그하거나 공유합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solte arquivos no notch para mantê-los à mão e depois arraste-os ou compartilhe-os."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетяните файлы на вырез, чтобы держать их под рукой, а потом перетянуть дальше или поделиться ими."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosyaları elinizin altında tutmak için çentiğe bırakın, sonra sürükleyin veya paylaşın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将文件拖放到刘海上以便随手取用，之后可拖移或共享。"
          }
        }
      }
    },
