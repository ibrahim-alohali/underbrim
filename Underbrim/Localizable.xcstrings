    "Calendar access is off. Turn it on in System Settings › Privacy & Security › Calendars." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوصول إلى التقويم متوقف. يمكنك تشغيله من إعدادات النظام › الخصوصية والأمن › التقويمات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kalenderzugriff ist deaktiviert. Aktiviere ihn in Systemeinstellungen › Datenschutz & Sicherheit › Kalender."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso al calendario está desactivado. Actívalo en Ajustes del Sistema › Privacidad y seguridad › Calendarios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès au calendrier est désactivé. Activez-le dans Réglages Système › Confidentialité et sécurité › Calendriers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun accesso a Calendario. Attivalo in Impostazioni di Sistema › Privacy e sicurezza › Calendari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カレンダーへのアクセスがオフです。“システム設定”＞“プライバシーとセキュリティ”＞“カレンダー”でオンにしてください。"
