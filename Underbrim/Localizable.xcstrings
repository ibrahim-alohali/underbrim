    "Tokens per day. Today %@. Busiest %@, %@. All 14 days %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرموز في اليوم. اليوم: %@. أكثر الأيام: %@، %@. مجموع 14 يومًا: %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokens pro Tag. Heute: %@. Spitzentag: %@, %@. 14 Tage insgesamt: %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokens por día. Hoy: %@. Día de más uso: %@, %@. Los 14 días: %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetons par jour. Aujourd’hui : %@. Jour le plus chargé : %@, %@. Total sur 14 jours : %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token al giorno. Oggi: %@. Giorno di maggiore utilizzo: %@, %@. Tutti i 14 giorni: %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日あたりのトークン数。今日は%1$@。最も多かったのは%2$@の%3$@。14日間の合計は%4$@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일별 토큰 수. 오늘 %1$@. 가장 많은 날 %2$@, %3$@. 14일 전체 %4$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokens por dia. Hoje: %@. Dia de maior uso: %@, %@. Todos os 14 dias: %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Токенов в день. Сегодня: %@. Больше всего: %@, %@. Всего за 14 дней: %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günlük token sayısı. Bugün %1$@. En yoğun gün %2$@, %3$@. 14 günün tamamı %4$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
