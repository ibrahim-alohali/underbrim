    "Your iPhone's Live Activities, calls, Focus, battery and downloads in the notch." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأنشطة المباشرة من iPhone والمكالمات والتركيز والبطارية والتنزيلات في النوتش."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-Aktivitäten deines iPhone, Anrufe, Fokus, Batterie und Downloads in der Notch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las actividades en directo de tu iPhone, las llamadas, los modos de concentración, la batería y las descargas en el notch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les activités en direct de votre iPhone, les appels, les modes de concentration, la batterie et les téléchargements dans l’encoche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attività in tempo reale di iPhone, chiamate, full immersion, batteria e download nel notch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノッチに表示するiPhoneのライブアクティビティ、通話、集中モード、バッテリー、ダウンロード。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노치에 표시되는 iPhone 실시간 현황, 통화, 집중 모드, 배터리 및 다운로드."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atividades ao Vivo do iPhone, chamadas, Foco, bateria e downloads no notch."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эфир активности с iPhone, вызовы, фокусирование, аккумулятор и загрузки в вырезе."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çentikte iPhone’unuzun Canlı Etkinlikleri, aramalar, Odak, pil ve indirmeler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刘海中的iPhone实时活动、通话、专注模式、电池和下载。"
          }
        }
      }
    },
