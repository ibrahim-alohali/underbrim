    "~/.claude/settings.json can't be read safely (%@), so it won't be changed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتعذر قراءة ‎~/.claude/settings.json بأمان (%@)، لذا لن يُغيَّر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.claude/settings.json kann nicht sicher gelesen werden (%@) und wird daher nicht geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.claude/settings.json no se puede leer con seguridad (%@), así que no se modificará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.claude/settings.json ne peut pas être lu en toute sécurité (%@) ; il ne sera donc pas modifié."
