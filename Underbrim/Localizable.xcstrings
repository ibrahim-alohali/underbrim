    "Codex couldn't be asked to trust the hook (%@). Review it in Codex instead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر أن يُطلب من Codex الوثوق بالخطاف (%@). يمكنك مراجعته في Codex بدلًا من ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex konnte nicht gebeten werden, dem Hook zu vertrauen (%@). Prüfe ihn stattdessen in Codex."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido pedir a Codex que confíe en el hook (%@). Revísalo en Codex."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de demander à Codex de faire confiance au hook (%@). Vérifiez-le plutôt dans Codex."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile chiedere a Codex di considerare attendibile l’hook (%@). Controllalo invece in Codex."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codexにフックを信頼するよう依頼できませんでした（%@）。代わりにCodexで確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex에 훅을 신뢰하도록 요청할 수 없습니다(%@). 대신 Codex에서 검토하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível pedir ao Codex que confie no hook (%@). Revise-o no Codex."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось попросить Codex доверять хуку (%@). Проверьте его в Codex."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex’ten kancaya güvenmesi istenemedi (%@). Bunun yerine Codex’te inceleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法请求Codex信任该钩子（%@）。请改为在Codex中审查。"
          }
        }
      }
    },
    "Codex didn't answer in time" : {
      "localizations" : {
        "ar" : {
