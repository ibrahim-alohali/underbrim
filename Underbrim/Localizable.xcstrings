        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新中に設定ファイルが変更されました。何も変更されていません。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트하는 동안 설정 파일이 변경되었습니다. 아무것도 변경되지 않았습니다. 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo de configuração mudou enquanto era atualizado. Nada foi alterado; tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл настроек изменился во время обновления. Ничего не изменено; повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar dosyası güncellenirken değişti. Hiçbir şey değiştirilmedi; yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置文件在更新过程中发生了变化。未做任何更改；请重试。"
          }
        }
      }
    },
    "The settings file couldn't be read safely (%@). Nothing was changed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة ملف الإعدادات بأمان (%@). لم يتغير شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einstellungsdatei konnte nicht sicher gelesen werden (%@). Es wurde nichts geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido leer de forma segura el archivo de ajustes (%@). No se ha cambiado nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de réglages n’a pas pu être lu en toute sécurité (%@). Rien n’a été modifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere il file delle impostazioni in modo sicuro (%@). Non è stato modificato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定ファイルを安全に読み取れませんでした（%@）。何も変更されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 파일을 안전하게 읽을 수 없습니다(%@). 아무것도 변경되지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler o arquivo de configuração com segurança (%@). Nada foi alterado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось безопасно прочитать файл настроек (%@). Ничего не изменено."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar dosyası güvenli bir şekilde okunamadı (%@). Hiçbir şey değiştirilmedi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
