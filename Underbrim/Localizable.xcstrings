    },
    "Underbrim lost its Now Playing connection. Reconnecting automatically..." : {
      "comment" : "Now Playing runtime failure message shown before an automatic recovery attempt.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقطع اتصال Underbrim بميزة \"قيد التشغيل\". تجري إعادة الاتصال تلقائيًا…"
