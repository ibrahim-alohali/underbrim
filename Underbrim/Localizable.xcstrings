            "value" : "تم تثبيت الاتصال. الخطوة التالية: تحميل الإضافة في Chrome."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindung installiert. Lade jetzt die Erweiterung in Chrome."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexión instalada. Ahora carga la extensión en Chrome."
          }
        },
        "fr" : {
