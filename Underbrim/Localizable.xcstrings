    "Another copy of Underbrim is receiving the agents' and Chrome's updates. Quit it to use this one." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخة أخرى من Underbrim تتلقى تحديثات الوكلاء وChrome. أنهِها لاستخدام هذه النسخة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere Kopie von Underbrim empfängt die Meldungen der Agenten und von Chrome. Beende sie, um diese zu verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra copia de Underbrim está recibiendo las novedades de los agentes y de Chrome. Ciérrala para usar esta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre copie d’Underbrim reçoit les mises à jour des agents et de Chrome. Quittez-la pour utiliser celle-ci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un’altra copia di Underbrim sta ricevendo gli aggiornamenti degli agenti e di Chrome. Chiudila per usare questa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のUnderbrimがエージェントとChromeからの更新を受信しています。このUnderbrimを使うには、そちらを終了してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 Underbrim 사본이 에이전트와 Chrome의 업데이트를 받고 있습니다. 이 사본을 사용하려면 그 사본을 종료하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outra cópia do Underbrim está recebendo as atualizações dos agentes e do Chrome. Encerre-a para usar esta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другая копия Underbrim получает обновления от агентов и Chrome. Закройте её, чтобы использовать эту."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Underbrim’in başka bir kopyası ajanların ve Chrome’un güncellemelerini alıyor. Bunu kullanmak için ondan çıkın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一份Underbrim正在接收智能体和Chrome的更新。请退出它以使用这一份。"
          }
        }
      }
    },
