    "Calendar access is denied. Please enable it in System Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم رفض الوصول إلى التقويم. يُرجى تمكينه في إعدادات النظام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kalenderzugriff wurde verweigert. Aktiviere ihn in den Systemeinstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendar access is denied. Please enable it in System Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha denegado el acceso al calendario. Actívalo en Ajustes del Sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
