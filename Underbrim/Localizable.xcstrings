    "%@ can't be read safely (%@), so it won't be changed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن قراءة %1$@ بأمان (%2$@)، لذا لن يتم تغييره."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kann nicht sicher gelesen werden (%2$@) und wird daher nicht geändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ can't be read safely (%2$@), so it won't be changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no se puede leer de forma segura (%2$@), así que no se modificará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ne peut pas être lu en toute sécurité (%2$@) ; il ne sera donc pas modifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere %1$@ in modo sicuro (%2$@), quindi non verrà modificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@を安全に読み取れないため（%2$@）、変更しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 파일을 안전하게 읽을 수 없어(%2$@) 변경하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
