    "Join opens only video links from known meeting services (Zoom, Google Meet, Teams, Webex, Whereby, Jitsi)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يفتح زر \"انضمام\" إلا روابط الفيديو من خدمات الاجتماعات المعروفة (Zoom و Google Meet و Teams و Webex و Whereby و Jitsi)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
