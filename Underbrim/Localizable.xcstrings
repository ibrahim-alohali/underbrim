    "If macOS asks about Underbrim's clipboard key, answer that dialog." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا عرض macOS مربع حوار بشأن مفتاح الحافظة الخاص بـ Underbrim، فيجب الرد عليه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
