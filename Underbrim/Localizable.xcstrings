    "Volume, brightness and keyboard light in the notch instead of macOS's." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مستوى الصوت والإضاءة وإضاءة لوحة المفاتيح في النوتش بدلًا من عرض macOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lautstärke, Helligkeit und Tastaturbeleuchtung in der Notch statt der Anzeige von macOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El volumen, el brillo y la luz del teclado en el notch, en lugar del indicador de macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le volume, la luminosité et l’éclairage du clavier dans l’encoche, à la place de ceux de macOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume, luminosità e retroilluminazione della tastiera nel notch, al posto degli indicatori di macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音量、明るさ、キーボードの輝度を、macOSの表示の代わりにノッチに表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 대신 노치에 표시되는 음량, 밝기 및 키보드 조명."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume, brilho e luz do teclado no notch, em vez do indicador do macOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Громкость, яркость и подсветка клавиатуры в вырезе вместо индикаторов macOS."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS’inkiler yerine çentikte ses, parlaklık ve klavye ışığı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在刘海中显示音量、亮度和键盘背光，取代macOS的指示器。"
          }
        }
      }
    },
    "Volume, brightness and keyboard light in the notch, Focus, Caps Lock, notification banners and iPhone Live Activities need it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاجه كلٌّ من عرض الصوت والسطوع وإضاءة لوحة المفاتيح في النوتش، والتركيز، وCaps Lock، ولافتات الإشعارات، والأنشطة المباشرة من iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benötigt für Lautstärke, Helligkeit und Tastaturbeleuchtung in der Notch, Fokus, Feststelltaste, Mitteilungsbanner und Live-Aktivitäten vom iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo necesitan el volumen, el brillo y la luz del teclado en el notch, los modos de concentración, Bloqueo Mayúsculas, las tiras de notificación y las actividades en directo del iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le volume, la luminosité et l’éclairage du clavier dans l’encoche, les modes de concentration, l’indicateur Verr. maj., les bannières de notification et les activités en direct de l’iPhone en ont besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne hanno bisogno volume, luminosità e retroilluminazione della tastiera nel notch, full immersion, Blocco maiuscole, banner delle notifiche e attività in tempo reale di iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノッチでの音量、明るさ、キーボードの輝度の表示、集中モード、Caps Lock、通知バナー、iPhoneのライブアクティビティで必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노치의 음량, 밝기 및 키보드 조명, 집중 모드, Caps Lock, 알림 배너 및 iPhone 실시간 현황에 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume, brilho e luz do teclado no notch, Foco, Caps Lock, banners de notificação e Atividades ao Vivo do iPhone precisam desta permissão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это нужно для громкости, яркости и подсветки клавиатуры в вырезе, фокусирования, Caps Lock, баннеров уведомлений и Эфира активности с iPhone."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çentikteki ses, parlaklık ve klavye ışığı, Odak, Büyük Harf Kilidi, bildirim başlıkları ve iPhone Canlı Etkinlikleri bu izni gerektirir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刘海中的音量、亮度和键盘背光，以及专注模式、大写锁定、通知横幅和iPhone实时活动都需要此权限。"
          }
        }
      }
    },
    "Volume, brightness and keyboard light in the notch, Focus, Caps Lock, notification banners, iPhone Live Activities, and Quick Launch hiding an app's windows." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مستوى الصوت والإضاءة وإضاءة لوحة المفاتيح في النوتش، والتركيز، وCaps Lock، ولافتات الإشعارات، والأنشطة المباشرة من iPhone، وإخفاء التشغيل السريع لنوافذ التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lautstärke, Helligkeit und Tastaturbeleuchtung in der Notch, Fokus, Feststelltaste, Mitteilungsbanner, Live-Aktivitäten vom iPhone und das Ausblenden der Fenster einer App durch Schnellstart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El volumen, el brillo y la luz del teclado en el notch, los modos de concentración, Bloqueo Mayúsculas, las tiras de notificación, las actividades en directo del iPhone y que Acceso rápido oculte las ventanas de una app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le volume, la luminosité et l’éclairage du clavier dans l’encoche, les modes de concentration, Verr. maj., les bannières de notification, les activités en direct de l’iPhone, et le masquage des fenêtres d’une app par l’Accès rapide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume, luminosità e retroilluminazione della tastiera nel notch, full immersion, Blocco maiuscole, banner di notifica, attività in tempo reale di iPhone e Avvio rapido che nasconde le finestre di un’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノッチでの音量・明るさ・キーボードの輝度の表示、集中モード、Caps Lock、通知バナー、iPhoneのライブアクティビティ、クイック起動によるアプリのウインドウの非表示。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노치의 음량, 밝기, 키보드 조명 표시, 집중 모드, Caps Lock, 알림 배너, iPhone 실시간 현황, 그리고 앱의 윈도우를 가리는 빠른 실행."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume, brilho e luz do teclado no notch, Foco, Caps Lock, banners de notificação, Atividades ao Vivo do iPhone e o Acesso Rápido ocultando as janelas de um app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Громкость, яркость и подсветка клавиатуры в вырезе, фокусирование, Caps Lock, баннеры уведомлений, Эфир активности с iPhone и скрытие окон приложения через Быстрый запуск."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çentikte ses yüksekliği, parlaklık ve klavye ışığı, Odak, Caps Lock, bildirim başlıkları, iPhone Canlı Etkinlikleri ve bir uygulamanın pencerelerini gizleyen Hızlı Başlat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刘海中的音量、亮度和键盘背光显示、专注模式、Caps Lock、通知横幅、iPhone实时活动，以及用快速启动隐藏App的窗口。"
