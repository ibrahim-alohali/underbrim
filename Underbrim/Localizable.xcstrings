    "Underbrim's Now Playing components are unavailable. Reopen or reinstall the app." : {
      "comment" : "Now Playing setup failure message shown when required bundled components cannot be used.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مكونات \"قيد التشغيل\" في Underbrim غير متوفرة. يُرجى إعادة فتح التطبيق أو إعادة تثبيته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Komponenten für „Jetzt läuft“ in Underbrim sind nicht verfügbar. Öffne oder installiere die App erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los componentes de Underbrim para Ahora suena no están disponibles. Vuelve a abrir la app o reinstálala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les composants « À l’écoute » d’Underbrim sont indisponibles. Rouvrez ou réinstallez l’app."
          }
        },
        "it" : {
