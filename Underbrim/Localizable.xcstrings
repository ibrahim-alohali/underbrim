    "Apps use ⌘ with one key for their own commands. Add ⌃, ⌥ or ⇧." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم التطبيقات ⌘ مع مفتاح واحد لأوامرها الخاصة. أضف ⌃ أو ⌥ أو ⇧."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps nutzen ⌘ mit einer Taste für eigene Befehle. ⌃, ⌥ oder ⇧ hinzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps usan ⌘ con una tecla para sus propios comandos. Añade ⌃, ⌥ o ⇧."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps utilisent ⌘ avec une touche pour leurs propres commandes. Ajoutez ⌃, ⌥ ou ⇧."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le app usano ⌘ con un tasto per i propri comandi. Aggiungi ⌃, ⌥ o ⇧."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘とキー1つは各アプリが独自のコマンドに使います。⌃、⌥、または⇧を加えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱은 ⌘와 키 하나를 자체 명령에 사용합니다. ⌃, ⌥ 또는 ⇧를 추가하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os apps usam ⌘ com uma tecla para os próprios comandos. Adicione ⌃, ⌥ ou ⇧."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложения используют ⌘ с одной клавишей для своих команд. Добавьте ⌃, ⌥ или ⇧."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamalar kendi komutları için ⌘ ile tek bir tuş kullanır. ⌃, ⌥ veya ⇧ ekleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各个 App 用 ⌘ 加一个键作为自己的命令。请加上 ⌃、⌥ 或 ⇧。"
          }
        }
      }
    },
