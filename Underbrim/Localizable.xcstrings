    "Blocked by macOS. Allow it in System Settings › Privacy & Security › Paste from Other Apps." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحظر macOS الوصول إلى الحافظة. السماح بالوصول في إعدادات النظام › الخصوصية والأمن › اللصق من تطبيقات أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von macOS blockiert. Erlaube den Zugriff in Systemeinstellungen › Datenschutz & Sicherheit › Aus anderen Apps einsetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueado por macOS. Permítelo en Ajustes del Sistema › Privacidad y seguridad › Pegar desde otras apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqué par macOS. Autorisez l’accès dans Réglages Système › Confidentialité et sécurité › Coller depuis d’autres apps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloccato da macOS. Consentilo in Impostazioni di Sistema › Privacy e sicurezza › Incolla da altre app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSによってブロックされています。“システム設定”＞“プライバシーとセキュリティ”＞“ほかのアプリからペースト”で許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS에서 차단했습니다. 시스템 설정 › 개인정보 보호 및 보안 › 다른 앱에서 붙여넣기에서 허용하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueado pelo macOS. Permita em Ajustes do Sistema › Privacidade e Segurança › Colar de Outros Apps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заблокировано macOS. Разрешите доступ: «Системные настройки» › «Конфиденциальность и безопасность» › «Вставка из других приложений»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS tarafından engellendi. Sistem Ayarları › Gizlilik ve Güvenlik › Diğer Uygulamalardan Yapıştır bölümünde izin verin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已被macOS阻止。请在“系统设置”›“隐私与安全”›“从其他App粘贴”中允许。"
          }
        }
      }
    },
