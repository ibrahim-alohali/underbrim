    "Press and hold a widget to pin it" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر مع الاستمرار على أداة لتثبيتها"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte ein Widget gedrückt, um es anzupinnen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado un widget para fijarlo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le clic sur un widget pour l’épingler"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto un widget per fissarlo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィジェットを長押ししてピン留め"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위젯을 길게 눌러 고정하기"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha um widget pressionado para fixá-lo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте виджет, чтобы закрепить его"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İğnelemek için bir araç takımını basılı tutun"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住小组件即可固定"
          }
        }
      }
    },
    "Press and hold any Home widget and the island keeps just that one, slim. Press and hold it again to unpin it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند النقر مع الاستمرار على أي أداة في الرئيسية، تُبقي الجزيرة تلك الأداة وحدها بشكل نحيف. ويُلغى تثبيتها بتكرار ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte ein Home-Widget gedrückt, und die Insel zeigt nur noch dieses, schmal. Halte es erneut gedrückt, um es loszulösen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado cualquier widget de Inicio y la isla mostrará solo ese, estrecho. Vuelve a mantenerlo pulsado para desfijarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le clic sur un widget de l’Accueil et l’île ne garde que celui-ci, fin. Maintenez-le de nouveau pour le détacher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto un widget di Home e l’isola mostra solo quello, sottile. Tienilo premuto di nuovo per sbloccarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホームのウィジェットを長押しすると、アイランドにはそのウィジェットだけが細く表示されます。もう一度長押しするとピン留めを解除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈의 위젯을 길게 누르면 아일랜드에 그 위젯만 얇게 표시됩니다. 다시 길게 누르면 고정이 해제됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha pressionado qualquer widget do Início e a ilha mostra só ele, fino. Mantenha-o pressionado de novo para desafixá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте любой виджет на «Главной», и на острове останется только он, узкий. Удерживайте его снова, чтобы открепить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana Sayfa’daki herhangi bir araç takımını basılı tuttuğunuzda ada yalnızca onu, ince bir şekilde gösterir. İğneyi kaldırmak için yeniden basılı tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住主页上的任一小组件，悬浮岛就只保留它，以窄条形式显示。再次按住即可取消固定。"
          }
        }
      }
    },
    "Press and hold any Home widget and the notch keeps just that one, slim, beside the camera. Press and hold it again to unpin it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند النقر مع الاستمرار على أي أداة في الرئيسية، يُبقي النوتش تلك الأداة وحدها بشكل نحيف بجانب الكاميرا. ويُلغى تثبيتها بتكرار ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte ein Home-Widget gedrückt, und die Notch zeigt nur noch dieses, schmal neben der Kamera. Halte es erneut gedrückt, um es loszulösen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado cualquier widget de Inicio y el notch mostrará solo ese, estrecho, junto a la cámara. Vuelve a mantenerlo pulsado para desfijarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le clic sur un widget de l’Accueil et l’encoche ne garde que celui-ci, fin, à côté de la caméra. Maintenez-le de nouveau pour le détacher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto un widget di Home e il notch mostra solo quello, sottile, accanto alla fotocamera. Tienilo premuto di nuovo per sbloccarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホームのウィジェットを長押しすると、ノッチにはそのウィジェットだけがカメラの横に細く表示されます。もう一度長押しするとピン留めを解除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈의 위젯을 길게 누르면 노치에 그 위젯만 카메라 옆에 얇게 표시됩니다. 다시 길게 누르면 고정이 해제됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha pressionado qualquer widget do Início e o notch mostra só ele, fino, ao lado da câmera. Mantenha-o pressionado de novo para desafixá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте любой виджет на «Главной», и в вырезе останется только он, узкий, рядом с камерой. Удерживайте его снова, чтобы открепить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana Sayfa’daki herhangi bir araç takımını basılı tuttuğunuzda çentik yalnızca onu, ince bir şekilde kameranın yanında gösterir. İğneyi kaldırmak için yeniden basılı tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住主页上的任一小组件，刘海就只保留它，以窄条形式显示在摄像头旁。再次按住即可取消固定。"
          }
        }
      }
    },
