    "Off: turn on Underbrim under System Audio Recording Only. Until then, every app plays as it is." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متوقف: يلزم تشغيل Underbrim ضمن \"تسجيل صوت النظام فقط\". وحتى ذلك الحين، يبقى صوت كل تطبيق كما هو."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus: Aktiviere Underbrim unter „Nur Systemaudioaufnahme“. Bis dahin spielt jede App unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado: activa Underbrim en «Solo grabación de audio del sistema». Hasta entonces, cada app suena tal cual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé : activez Underbrim sous « Enregistrement audio du système uniquement ». D’ici là, le son de chaque app reste inchangé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato: attiva Underbrim in “Solo registrazione audio di sistema”. Fino ad allora, ogni app suona così com’è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフ: “システムオーディオ録音のみ”でUnderbrimをオンにしてください。それまでは、すべてのアプリが現状のまま再生されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꺼짐: ‘시스템 오디오 녹음 전용’에서 Underbrim을 켜십시오. 그때까지는 모든 앱이 그대로 재생됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado: ative o Underbrim em “Somente Gravação de Áudio do Sistema”. Até lá, cada app toca como está."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключено: включите Underbrim в разделе «Только запись системного звука». До тех пор каждое приложение звучит как обычно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapalı: “Yalnızca Sistem Sesi Kaydı” altında Underbrim’i açın. O zamana kadar her uygulama olduğu gibi çalar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已关闭：请在“仅系统录音”下打开Underbrim。在此之前，所有App都按原样播放。"
          }
        }
      }
    },
