    "Customize which controls appear in the media player. Volume expands when active." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تخصيص عناصر التحكم التي تظهر في مشغّل الوسائط. يتّسع عنصر مستوى الصوت عند استخدامه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege fest, welche Steuerelemente im Mediaplayer erscheinen. Der Lautstärkeregler wird bei Benutzung breiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personaliza qué controles aparecen en el reproductor. El volumen se amplía al usarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les commandes affichées dans le lecteur. Le volume s’agrandit quand vous l’utilisez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalizza i controlli che appaiono nel lettore multimediale. Il volume si espande quando è attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メディアプレーヤーに表示するコントロールをカスタマイズします。音量は操作中に広がります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미디어 플레이어에 표시할 제어 항목을 사용자화합니다. 음량은 사용할 때 확장됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalize os controles que aparecem no reprodutor de mídia. O controle de volume se expande quando está em uso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите элементы управления медиаплеера. Регулятор громкости разворачивается при использовании."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medya oynatıcısında hangi denetimlerin görüneceğini özelleştirin. Ses yüksekliği etkin olduğunda genişler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义媒体播放器中显示的控制项。音量控制在使用时会展开。"
          }
        }
      }
    },
